# ================= LLM（OpenAI 兼容协议，任意平台可换）=================
LLM_API_KEY=sk-你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 若想用百炼的 Qwen 生成（与下面 Embedding 共用一个 key，取消注释即可）：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ================= Embedding（阿里云百炼）=================
EMBEDDING_API_KEY=sk-你的百炼key
# 经典公网接入点（一般可直接用）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 若调用报 404/模型不存在，改用控制台给你的新版地域接入点（替换 {WorkspaceId}）：
# EMBEDDING_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding

# ================= Rerank（第二阶段混合检索时启用）=================
RERANK_MODEL=gte-rerank-v2

# ================= 检索（Phase 1 混合检索）=================
# hybrid = 稠密向量 + BM25（RRF 融合，需 EMBEDDING_API_KEY）；bm25 = 纯词法基线
RETRIEVAL_MODE=hybrid
DENSE_TOP_K=8
RRF_K=60

# ================= 查询改写与重排（Phase 2）=================
REWRITE_ENABLED=1
RERANK_ENABLED=1
RERANK_POOL=8
# DashScope 原生 rerank API 根地址（默认经典公网，一般不用改）
# RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ================= 意图路由（Phase 2.5）=================
# 提取型走严格摘抄，推理型走分析模式（允许有据推断，事实仍须溯源）
INTENT_ROUTING_ENABLED=1
ANALYTICAL_TOP_K=6
# 生成思考档位：low=快（分析题约 1 分钟）| high/max=深（但可能 5-12 分钟/题）| 留空=网关默认
ANSWER_THINKING_LEVEL=low

# ================= 论文知识库（Qdrant）=================
# LIBRARY_MODE=1 时界面为「论文库」形态（多论文持久化）；0 为单篇会话模式（评测用）
LIBRARY_MODE=1
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=papers
EMBEDDING_DIM=1024
